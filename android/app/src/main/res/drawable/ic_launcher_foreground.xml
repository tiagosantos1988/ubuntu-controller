<?xml version="1.0" encoding="utf-8"?>
<!--
  Icone do app: controle remoto quase quadrado, com o emissor laranja na
  linha da borda de cima (metade para fora), o simbolo do Ubuntu no lugar do
  direcional e tres botoes em fila embaixo.

  Mesma geometria de app/controle-remoto.svg: se mudar um, mude o outro.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- A escala aqui e 1,15, menor que os 1,35 do SVG: o adaptive icon so
         garante o miolo de 66x66 do viewport de 108, e o launcher corta o
         resto com a mascara dele. A 1,35 o corpo saia dessa area. -->
    <group
        android:pivotX="54"
        android:pivotY="54"
        android:scaleX="1.05"
        android:scaleY="1.05">
        <!-- corpo do controle -->
        <path
